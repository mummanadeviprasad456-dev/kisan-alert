rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Users Collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || (isAuthenticated() && getUserRole() == 'admin');
    }

    // Farms Collection rules
    match /farms/{farmId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.resource.data.farmerId == request.auth.uid || getUserRole() == 'admin');
      allow delete: if isAuthenticated() && getUserRole() == 'admin';
    }

    // Disease Reports rules
    match /disease_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && getUserRole() == 'admin';
    }

    // Advisories rules
    match /advisories/{advisoryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.farmerId == request.auth.uid;
      allow update: if isAuthenticated() && (getUserRole() == 'expert' || getUserRole() == 'admin');
      allow delete: if isAuthenticated() && getUserRole() == 'admin';
    }

    // Alerts rules
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (getUserRole() == 'admin' || getUserRole() == 'expert');
    }
  }
}
